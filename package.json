{
  "name": "jane",
  "version": "1.0.0",
  "private": true,
  "description": "Jane: an adaptive learning app for kids on Cloudflare Workers, built on the Marble Skill Taxonomy.",
  "type": "module",
  "license": "SEE LICENSING.md",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "./deploy.sh",
    "deploy:dry": "./deploy.sh --dry-run --outdir .wrangler/dist",
    "export": "node export-progress.mjs",
    "publish:dry": "node publish-lessons.mjs packs/examples/example-quest.json --dry-run",
    "backup": "node backup-progress.mjs"
  },
  "devDependencies": { "wrangler": "4.149.0" }
}
